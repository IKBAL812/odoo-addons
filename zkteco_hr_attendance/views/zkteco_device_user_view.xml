<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="zkteco_device_user_tree" model="ir.ui.view">
        <field name="name">zkteco.device.user.tree</field>
        <field name="model">zkteco.device.user</field>
        <field name="arch" type="xml">
            <tree>
                <field name="device_id" />
                <field name="device_user_id" />
                <field name="name" />
                <field name="employee_id" />
                <field name="privilege" />
                <field name="zkteco_uid" />
            </tree>
        </field>
    </record>

    <record id="zkteco_device_user_form" model="ir.ui.view">
        <field name="name">zkteco.device.user.form</field>
        <field name="model">zkteco.device.user</field>
        <field name="arch" type="xml">
            <form string="ZKTeco Device User">
                <sheet>
                    <group>
                        <group>
                            <field name="device_id" />
                            <field name="employee_id" />
                            <field name="device_user_id" />
                            <field name="name" />
                        </group>
                        <group>
                            <field name="privilege" />
                            <field name="password" />
                            <field name="group_id" />
                            <field name="card" />
                            <field name="zkteco_uid" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zkteco_device_user_search" model="ir.ui.view">
        <field name="name">zkteco.device.user.search</field>
        <field name="model">zkteco.device.user</field>
        <field name="arch" type="xml">
            <search>
                <field name="device_user_id" />
                <field name="name" />
                <field name="employee_id" />
                <field name="device_id" />
                <filter
                    name="group_by_device"
                    string="Device"
                    context="{'group_by': 'device_id'}"
                />
            </search>
        </field>
    </record>

    <record id="action_zkteco_device_user" model="ir.actions.act_window">
        <field name="name">ZKTeco Device Users</field>
        <field name="res_model">zkteco.device.user</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="zkteco_device_user_tree" />
        <field name="search_view_id" ref="zkteco_device_user_search" />
    </record>

    <menuitem
        id="zkteco_device_user_menu"
        name="ZKTeco Device Users"
        parent="hr.menu_human_resources_configuration"
        action="action_zkteco_device_user"
        groups="hr_attendance.group_hr_attendance_manager"
    />
</odoo>
